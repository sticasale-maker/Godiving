{
  // Deployed by Cloudflare Workers Builds on every push to main.
  // Build command:  bash cloudflare/build.sh   (assembles dist/)
  // Deploy command: npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "godiving",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Required. Workers serve a matching static asset WITHOUT running the
    // Worker unless this is set — so the gate never executed and the whole
    // app was served to anyone. Any auth check in front of static assets
    // needs this.
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  // Declared here, not in the dashboard: `wrangler deploy` replaces plain
  // vars with whatever the config declares, so a dashboard-set ACCESS_HOST
  // is wiped by the next push. Secrets (GATE_PASSWORD) are preserved and
  // stay out of the repo.
  //
  // This names the one hostname where Cloudflare Access is in front of the
  // Worker, and is the only hostname whose Access header the gate trusts.
  "vars": {
    "ACCESS_HOST": "godiving.sticasale.workers.dev"
  }
}
